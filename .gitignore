# Never commit your family's details
family-field-guide-*.json
family-field-guide-*.html
family-field-guide-backup.json
family-guide-*.json
family-guide-checkup.ics
my-sections.json
gitignore.txt
*.backup.json
.DS_Store

# Pure native Apple (SwiftPM / Xcode) build artifacts
native/apple/.build/
native/apple/.swiftpm/
native/apple/DerivedData/

# Pure native Android build artifacts
native/android/.gradle/
native/android/build/
native/android/app/build/
native/android/local.properties
native/android/.idea/

# Pure native Windows (.NET) build artifacts
native/windows/**/bin/
native/windows/**/obj/
native/windows/.vs/
native/windows/publish/

# Pure native Linux (Rust / Cargo) build artifacts
native/linux/target/
native/linux/dist/
