<Window x:Class="FamilyGuide.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Our Family Field Guide"
        Icon="Resources/app.ico"
        FontFamily="{StaticResource SansFont}"
        Width="1180" Height="820" MinWidth="800" MinHeight="560"
        Background="{StaticResource PaperBrush}">
    <Grid>
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource Paper2Brush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Viewbox Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="128" Height="128">
                                    <Rectangle Width="128" Height="128" RadiusX="28" RadiusY="28" Fill="#F6F1E6" />
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="112" Height="112" RadiusX="22" RadiusY="22" Stroke="#1F3A2E" StrokeThickness="6" />
                                    <Path Data="M64,26 L28,54 L28,98 L100,98 L100,54 Z" Fill="#FFFDF8" Stroke="#1F3A2E" StrokeThickness="5" StrokeLineJoin="Round" />
                                    <Path Data="M64,84 C53,76.5 46,70 46,62 A10,10 0 0,1 64,56 A10,10 0 0,1 82,62 C82,70 75,76.5 64,84 Z" Fill="#D2512F" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="OPEN THIS FIRST" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TomatoBrush}" />
                                <TextBlock Text="Our Family Field Guide" FontFamily="{StaticResource SerifFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Width="180" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PctText" Text="0% filled" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,4" />
                        <ProgressBar x:Name="PctBar" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource TomatoBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="TOOLS" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Ink2Brush}" Margin="2,0,0,4" />
                        <Button Content="+ Add Section / Template" Click="OnAddSectionClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="1-Page Executive Summary" Click="OnSummaryClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="1-Page ER Grab Sheet" Click="OnErGrabClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Readiness &amp; Fire Drill" Click="OnReadinessClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Save Locked Backup" Click="OnBackupClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Open / Merge Backup" Click="OnRestoreClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                    </StackPanel>

                    <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" SelectionChanged="OnTabSelected" />
                </DockPanel>
            </Border>

            <!-- Main Content -->
            <DockPanel Grid.Column="1">
                <!-- Top Bar -->
                <Border x:Name="TopBarBorder" DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <WrapPanel VerticalAlignment="Center" ItemHeight="30">
                        <TextBox x:Name="SearchBox" Width="210" Padding="8,4" Margin="0,0,8,0" ToolTip="Search guide ($1M, AILA, crypto, SSN, fever)" KeyDown="OnSearchKeyDown" />
                        <Button Content="Search" Click="OnSearchClick" Padding="10,4" Margin="0,0,10,0" />
                        <ComboBox x:Name="RegionCombo" Width="190" Margin="0,0,10,0" SelectionChanged="OnRegionChanged" />
                        <CheckBox x:Name="ReadModeToggle" Content="Read Mode" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnReadModeToggled" Unchecked="OnReadModeToggled" />
                        <CheckBox x:Name="LargeTextToggle" Content="A+" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnLargeTextToggled" Unchecked="OnLargeTextToggled" />
                        <CheckBox x:Name="ContrastToggle" Content="Contrast" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnContrastToggled" Unchecked="OnContrastToggled" />
                        <Button Content="Print Sheet" Click="OnPrintSummaryClick" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Lock" Click="OnLockClick" Padding="10,4" />
                    </WrapPanel>
                </Border>

                <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel x:Name="ContentHost" MaxWidth="860" HorizontalAlignment="Left" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Lock Screen Overlay -->
        <Border x:Name="LockOverlay" Background="{StaticResource PaperBrush}" Visibility="Collapsed">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="8" Padding="28" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Viewbox Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Canvas Width="128" Height="128">
                            <Rectangle Width="128" Height="128" RadiusX="28" RadiusY="28" Fill="#F6F1E6" />
                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="112" Height="112" RadiusX="22" RadiusY="22" Stroke="#1F3A2E" StrokeThickness="6" />
                            <Path Data="M64,26 L28,54 L28,98 L100,98 L100,54 Z" Fill="#FFFDF8" Stroke="#1F3A2E" StrokeThickness="5" StrokeLineJoin="Round" />
                            <Path Data="M64,84 C53,76.5 46,70 46,62 A10,10 0 0,1 64,56 A10,10 0 0,1 82,62 C82,70 75,76.5 64,84 Z" Fill="#D2512F" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Our Family Field Guide is Locked" FontFamily="{StaticResource SerifFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" TextAlignment="Center" />
                    <TextBlock Text="Enter your session lock passphrase to continue." FontSize="13" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,12" TextAlignment="Center" />
                    <PasswordBox x:Name="LockPassBox" Padding="6" Margin="0,0,0,10" />
                    <TextBlock x:Name="LockErrText" Foreground="{StaticResource TomatoBrush}" FontSize="12" Margin="0,0,0,8" />
                    <Button Content="Unlock" Click="OnUnlockAttempt" Padding="12,6" Background="{StaticResource InkBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
