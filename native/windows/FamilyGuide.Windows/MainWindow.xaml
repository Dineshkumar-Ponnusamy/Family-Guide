<Window x:Class="FamilyGuide.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Our Family Field Guide"
        Width="1160" Height="820" MinWidth="780" MinHeight="540"
        Background="{StaticResource PaperBrush}">
    <Grid>
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Paper2Brush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Our Family Field Guide" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PctText" Text="0% filled" FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,6,0,4" />
                        <ProgressBar x:Name="PctBar" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource TomatoBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Ink2Brush}" Margin="2,0,0,4" />
                        <Button Content="+ Add Section / Template" Click="OnAddSectionClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="1-Page Executive Summary" Click="OnSummaryClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="1-Page ER Grab Sheet" Click="OnErGrabClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Readiness &amp; Fire Drill" Click="OnReadinessClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Save Locked Backup" Click="OnBackupClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                        <Button Content="Open / Merge Backup" Click="OnRestoreClick" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left" />
                    </StackPanel>

                    <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" SelectionChanged="OnTabSelected" />
                </DockPanel>
            </Border>

            <!-- Main Content -->
            <DockPanel Grid.Column="1">
                <!-- Top Bar -->
                <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <WrapPanel VerticalAlignment="Center" ItemHeight="30">
                        <TextBox x:Name="SearchBox" Width="250" Padding="8,4" Margin="0,0,10,0" ToolTip="Search guide ($1M, AILA, crypto, SSN, fever)" KeyDown="OnSearchKeyDown" />
                        <Button Content="Search" Click="OnSearchClick" Padding="10,4" Margin="0,0,12,0" />
                        <ComboBox x:Name="RegionCombo" Width="210" Margin="0,0,12,0" SelectionChanged="OnRegionChanged" />
                        <CheckBox x:Name="ReadModeToggle" Content="Read Mode" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnReadModeToggled" Unchecked="OnReadModeToggled" />
                        <Button Content="Print Sheet" Click="OnPrintSummaryClick" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Lock" Click="OnLockClick" Padding="10,4" />
                    </WrapPanel>
                </Border>

                <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel x:Name="ContentHost" MaxWidth="860" HorizontalAlignment="Left" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Lock Screen Overlay -->
        <Border x:Name="LockOverlay" Background="{StaticResource PaperBrush}" Visibility="Collapsed">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="8" Padding="28" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Our Family Field Guide is Locked" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Enter your session lock passphrase to continue." FontSize="13" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,12" />
                    <PasswordBox x:Name="LockPassBox" Padding="6" Margin="0,0,0,10" />
                    <TextBlock x:Name="LockErrText" Foreground="{StaticResource TomatoBrush}" FontSize="12" Margin="0,0,0,8" />
                    <Button Content="Unlock" Click="OnUnlockAttempt" Padding="12,6" Background="{StaticResource InkBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
